# Copy this file to .env and adjust values as needed.
# Never commit the real .env file.

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-secret-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production

# JWT token lifetime, in minutes
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# Database (SQLite file, created automatically on first run)
# Leave this commented out to use the default location: backend/smartcart.db
# If you do set it, use an ABSOLUTE path (sqlite:////absolute/path/to/file.db) -
# a relative "sqlite:///smartcart.db" gets resolved inside Flask's instance/
# folder instead of the backend/ folder, which is confusing on Windows.
# DATABASE_URL=sqlite:///smartcart.db

# CORS - the Vite dev server origin
CORS_ORIGINS=http://localhost:5173

# Server
PORT=5000
